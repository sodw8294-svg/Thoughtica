# =============================================================================
# thoughtica.io — Required Environment Variables
# =============================================================================
# Copy this file to .env for local development (never commit .env to git).
# Set all production values in your Vercel project settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe (required for payments)
# -----------------------------------------------------------------------------

# Stripe SECRET key — server-side only. Never expose to the browser.
# Find it in the Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=sk_test_...

# Stripe PUBLISHABLE key — embedded in the frontend at build time.
# Find it in the Stripe Dashboard > Developers > API keys.
VITE_STRIPE_PK=pk_test_...

# Stripe webhook endpoint secret — validates that webhook events come from Stripe.
# Created in Stripe Dashboard > Developers > Webhooks > (your endpoint) > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Firebase (required for user accounts and tier persistence)
# -----------------------------------------------------------------------------

# Firebase CLIENT config — embedded in the frontend at build time.
# Find these in Firebase Console > Project Settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase ADMIN service account — server-side only for the webhook handler.
# Generate in Firebase Console > Project Settings > Service accounts > Generate new private key.
# Paste the entire JSON as a single-line string (use jq: jq -c . serviceAccount.json).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# -----------------------------------------------------------------------------
# App URL (optional — Vercel sets VERCEL_URL automatically)
# -----------------------------------------------------------------------------

# Override the base URL used in Stripe success/cancel redirect URLs.
# If not set, falls back to https://${VERCEL_URL} (auto-set by Vercel) then
# https://thoughtica.io as a last resort.
# PUBLIC_URL=https://your-custom-domain.com

# -----------------------------------------------------------------------------
# AI Chat providers (optional — at least one required for the chat feature)
# -----------------------------------------------------------------------------

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama3-8b-8192

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
