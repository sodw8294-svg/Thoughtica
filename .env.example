# ──────────────────────────────────────────────────────────────
# Thoughtica – Required Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.
# ──────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────
# Your Stripe SECRET key (server-side only – never expose to the browser)
# Find it at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Your Stripe PUBLISHABLE key (safe to expose – sent to the browser via /api/config)
STRIPE_PUBLIC_KEY=pk_test_...

# Webhook signing secret for /api/stripe-webhook
# Generate with: stripe listen --forward-to localhost:3000/api/stripe-webhook
# Or find it in: Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Firebase Admin (server-side only) ────────────────────────
# Stringified JSON of your Firebase service account credentials.
# Download from: Firebase Console > Project Settings > Service accounts > Generate new private key
# Then run: cat serviceAccountKey.json | jq -c . | pbcopy  (macOS)
# Paste the single-line JSON string here (wrapped in single quotes to avoid shell interpolation)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# ── Application ──────────────────────────────────────────────
# The public base URL of your deployed app (used for Stripe success/cancel redirects)
# For local dev: http://localhost:3000
# For production: https://yourdomain.com
PUBLIC_URL=https://thoughtica.io

# ── AI Chat providers (at least one required for chat features) ──
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
